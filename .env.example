# Copy to .env and set for this deployment. Never commit the result.
# Paths below are examples. <ARCHIVE_ROOT> is the managed location ATLAS owns.

# Required for archive operations. No default: there is no safe guess.
BEACON_ARCHIVE_ROOT=<ARCHIVE_ROOT>

# Optional. Default: <ARCHIVE_ROOT>/Beacon/beacon.db when the archive root is
# configured, otherwise the legacy local runtime path with a warning.
BEACON_DB=

# Optional. Default: alongside the catalog, beneath the archive root.
BEACON_BACKUP_DIR=
BEACON_DERIVATIVES_DIR=
BEACON_ARCHIVE_LOG_DIR=

# Optional. Intake area. Default: <ARCHIVE_ROOT>/Inbox.
BEACON_INBOX=

BEACON_LOG_LEVEL=INFO
BEACON_STABILITY_SECONDS=2
BEACON_FFPROBE=
BEACON_FFMPEG=
